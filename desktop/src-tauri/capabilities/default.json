{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Only the local main window may use application commands. File and provider access is implemented by scoped Rust commands.",
  "windows": ["main"],
  "permissions": ["core:default", "core:window:allow-minimize", "core:window:allow-toggle-maximize", "core:window:allow-close", "core:window:allow-start-dragging", "core:window:allow-start-resize-dragging"]
}

